# Copy to .env, or run just init <network>. Never commit the populated .env.
# Secrets may instead be supplied through vars; see .vars.yaml.

# Solver fork tests: use an Ethereum mainnet RPC URL, or an Alchemy API key.
# MAINNET_RPC_URL=
# ALCHEMY_API_KEY=
# Optional live aggregator credentials; their tests skip when a key is absent.
# ZERO_EX_API_KEY=
# ONEINCH_API_KEY=
# Uniswap, KyberSwap and Velora tests do not require aggregator API keys.
# Opt in when running tests (do not enable globally):
# RUN_FORK_TESTS=true RUN_LIVE_QUOTES=true forge test --match-contract GenericOpenFillForkTest --ffi -vv

# Katana buyback -> avKAT donation fork test (public RPC, pinned block by default).
# KATANA_RPC_URL=https://rpc.katana.network
# KATANA_FORK_BLOCK=47557066
# RUN_KATANA_FORK_TESTS=true forge test --match-contract AvKatBuybackForkTest -vv

# Signing key required by Deploy.s.sol and Install.s.sol.
# DEPLOYER_KEY=
# ETHERSCAN_API_KEY=
# RPC_URL=
# PINATA_JWT=

# Deployment settings. The active just-foundry network supplies the OSx
# addresses. Uncomment to override them for this project.
# MANAGEMENT_DAO_ADDRESS=0x...
# PLUGIN_REPO_FACTORY_ADDRESS=0x...
# PLUGIN_REPO_SUBDOMAIN=capital-pipeline
# PLUGIN_REPO_MAINTAINER=0x...

# Installation settings. Fill in your config and the deployed plugin repo.
# The active network supplies PLUGIN_SETUP_PROCESSOR_ADDRESS; override it here if needed.
# INSTALL_CONFIG=installs/buy-and-burn.json
# PLUGIN_REPO=0x...
# PLUGIN_SETUP_PROCESSOR_ADDRESS=0x...

# Optional just-foundry helpers.
# FORK_BLOCK_NUMBER=
# REFUND_ADDRESS=0x...
